# Local demo defaults only. Do not reuse these credentials outside the QA stand.
FRONTEND_PORT=3000
ORDER_SERVICE_PORT=8002
ORDER_DB_PORT=5434
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_app
ORDER_DB_PASSWORD=order_app

# Vite development overrides. Docker frontend uses same-origin nginx proxies.
VITE_CUSTOMER_API_BASE=/api/customer
VITE_SUPPLIER_API_BASE=/api/supplier
VITE_ORDER_API_BASE=/api/order
VITE_ORDER_POLLING_MS=2000
